# Vercel KV / Upstash Redis REST API Credentials
# These are automatically populated by Vercel when linking a Vercel KV store.
# Copy these values into `.env.local` for local development if you wish to connect local `pnpm dev` to Vercel KV.

KV_REST_API_URL="https://your-kv-db.upstash.io"
KV_REST_API_TOKEN="your_kv_rest_api_token_here"
KV_REST_API_READ_ONLY_TOKEN="your_kv_rest_api_read_only_token_here"
KV_URL="redis://default:token@your-kv-db.upstash.io:6379"
